<title>香港「床位生意」：宿位在擴容，可負擔性在縮水｜【數據】</title>
<meta name="description" content="23億元收購案背後，香港非本地生大增、宿位擴容，但可負擔宿位與租金壓力正轉嫁至學生。">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@700;900&family=Source+Sans+3:wght@400;700&family=Source+Serif+4:wght@700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#16293F;
    --slate:#5B6573;
    --rust:#C4502A;
    --gray:#B5BAC1;
    --navy:#1F3A5F;
    --mist:#EEF2F6;
    --paper:#FFFFFF;
    --grid:#E4E7EB;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;}
  body{
    background-color: #FFFFFF;
    color:var(--ink);
    font-family:"Source Sans 3","Noto Sans TC","PingFang HK","Microsoft JhengHei",sans-serif;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  a{color:var(--navy);text-decoration:none;border-bottom:1px solid rgba(31,58,95,.3);}
  a:hover{border-bottom-color:var(--navy);}

  .bg-scene {
    position: fixed; bottom: 0; left: 0; width: 100%; height: 60vh;
    min-height: 400px; perspective: 1200px; z-index: 0;
    pointer-events: none; display: flex; align-items: flex-end;
    justify-content: center; overflow: hidden;
  }
  .bg-houses {
    width: 100%; height: 100%; transform-origin: bottom center;
    will-change: transform, opacity;
    transition: transform 0.1s ease-out, opacity 0.1s ease-out;
    opacity: 0.4;
  }
  .bg-houses svg { width: 100%; height: 100%; display: block; }

  .progress{
    position:fixed;top:0;left:0;height:3px;width:0;
    background:linear-gradient(90deg,var(--rust),#E07A4F);
    z-index:120; transition:width .08s linear;
    box-shadow:0 0 6px rgba(196,80,42,.4);
  }

  .page{
    max-width:1040px; margin:0 auto; padding:0 24px 96px;
    position:relative; z-index:1;
  }
  .col{
    max-width:640px; margin:0 auto;
    position:relative; z-index:2;
  }

  .kicker{
    font-size:13px; font-weight:700; letter-spacing:.1em;
    color:var(--rust); margin:48px 0 16px;
  }
  h1{
    font-family:"Noto Serif TC",serif; font-weight:900;
    font-size:40px; line-height:1.32; letter-spacing:.01em;
    margin-bottom:16px;
  }
  .subtitle{
    font-family:"Noto Serif TC",serif; font-size:24px; line-height:1.45;
    color:var(--slate); font-weight:700; margin-bottom:24px;
    white-space: normal;
  }
  .lede{
    font-family:"Noto Serif TC",serif; font-size:20px; line-height:1.7;
    color:var(--slate); font-weight:400; margin-bottom:36px;
  }

  .byline{
    border-top:1px solid var(--grid); border-bottom:1px solid var(--grid);
    padding:18px 0; margin-bottom:48px;
    display:grid; grid-template-columns:repeat(2,minmax(0,1fr));
    gap:8px 24px; font-size:14px; line-height:1.6; color:var(--slate);
  }
  .byline div{display:flex;gap:10px;}
  .byline .k{flex:0 0 74px; color:var(--gray); font-weight:700; letter-spacing:.02em;}
  .byline .v{color:var(--ink);}

  .body-text p{
    font-family:"Noto Sans TC",sans-serif; font-size:18px; line-height:1.9;
    letter-spacing:.01em; margin-bottom:28px; text-align:left;
  }
  .body-text p:last-child{margin-bottom:0;}

  h2{
    font-family:"Noto Serif TC",serif; font-size:24px; line-height:1.5;
    font-weight:700; margin:56px 0 24px; padding-top:26px;
    border-top:1px solid var(--grid);
  }

  .mark{
    background-image:linear-gradient(to top,rgba(196,80,42,.15) 0%,rgba(196,80,42,.15) 42%,transparent 42%);
    background-repeat:no-repeat; background-position:left bottom;
    background-size:0% 100%;
    transition:background-size .9s cubic-bezier(.2,.7,.2,1) .35s;
    font-weight:700; color:var(--ink);
  }
  .reveal.in .mark{background-size:100% 100%;}

  .stats{
    display:grid; grid-template-columns:repeat(5,1fr); gap:12px;
    margin:0 0 48px; padding:28px 0;
    border-top:1px solid var(--grid); border-bottom:1px solid var(--grid);
    position:relative;z-index:2;
  }
  .stat{text-align:left; padding-right:12px; border-right:1px solid var(--grid);}
  .stat:last-child{border-right:0;}
  .stat .num{
    font-family:"Source Sans 3","Noto Sans TC",sans-serif;
    font-size:34px; font-weight:700; line-height:1.1;
    color:var(--rust); display:block; font-variant-numeric:tabular-nums;
  }
  .stat .lbl{
    display:block; font-size:12px; color:var(--slate);
    line-height:1.5; margin-top:6px;
  }

  figure.pic{margin:48px auto; width:100%;}
  figure.pic .img-wrap{
    border-radius:4px; overflow:hidden; background:var(--mist);
    border:1px solid var(--grid);
  }
  figure.pic img{
    width:100%; height:auto; display:block;
    object-fit:cover; transition:transform .6s ease;
  }
  figure.pic:hover img{transform:scale(1.02);}
  figure.pic figcaption{
    margin-top:12px; font-family:"Noto Sans TC",sans-serif;
    font-size:13px; line-height:1.6; color:var(--slate); padding-left:2px;
  }
  figure.pic .credit{
    display:block; margin-top:4px; font-size:12px;
    color:var(--gray); letter-spacing:.02em;
  }

  figure.wide{
    position:relative; left:50%; transform:translateX(-50%);
    width:min(1040px, calc(100vw - 32px)); margin:48px 0; z-index:2;
  }
  iframe.fig{
    width:100%; border:0; display:block; background:#fff;
    min-height:520px; opacity:0; transition:opacity .6s ease;
    box-shadow:0 4px 24px rgba(0,0,0,0.03); border-radius:4px;
  }
  iframe.fig.loaded{opacity:1;}

  .tool-block{
    position:relative; left:50%; transform:translateX(-50%);
    width:min(860px, calc(100vw - 32px));
    margin:56px 0 40px;
    background:linear-gradient(180deg,rgba(238,242,246,0.95),rgba(247,249,251,0.95));
    padding:28px 24px 24px; border-radius:8px;
    box-shadow:0 2px 12px rgba(0,0,0,0.02);
    backdrop-filter:blur(4px); z-index:2;
  }
  .tool-block .tool-head{max-width:640px; margin:0 auto 20px;}
  .tool-block h3{
    font-family:"Noto Serif TC",serif; font-size:21px; line-height:1.5;
    font-weight:700; margin-bottom:8px;
  }
  .tool-block p{
    font-family:"Noto Sans TC",sans-serif; font-size:15px;
    line-height:1.7; color:var(--slate);
  }
  .tool-block iframe.fig{
    background:transparent; min-height:640px; box-shadow:none;
  }

  .notes{
    margin-top:64px; padding-top:32px;
    border-top:2px solid var(--ink); position:relative;z-index:2;
  }
  .notes h2{
    border-top:0; padding-top:0; margin-top:0;
    font-size:21px; margin-bottom:20px;
  }
  .notes h3{
    font-family:"Noto Sans TC",sans-serif; font-size:15px;
    font-weight:700; letter-spacing:.04em; color:var(--ink);
    margin:26px 0 8px;
  }
  .notes p, .notes li{
    font-family:"Noto Sans TC",sans-serif; font-size:14px;
    line-height:1.85; color:var(--slate);
  }
  .notes ul{list-style:none;padding:0;}
  .notes li{padding-left:1.1em;text-indent:-1.1em;}
  .notes li::before{content:"— ";}
  .notes strong{color:var(--ink);font-weight:700;}

  .side-nav{
    position:fixed; left:24px; top:50%; transform:translateY(-50%);
    display:flex; flex-direction:column; gap:14px; z-index:80;
  }
  .side-nav a{
    display:flex; align-items:center; gap:10px; border:0;
    text-decoration:none; color:var(--gray); font-size:12px;
  }
  .side-nav a .house-icon{
    width:24px; height:24px; fill:none; stroke:var(--gray);
    stroke-width:1.5; stroke-linejoin:round; transition:all .25s;
    background:var(--paper); border-radius:50%; padding:4px;
    box-shadow:0 2px 6px rgba(0,0,0,0.05);
  }
  .side-nav a em{
    font-style:normal; font-size:12px; color:var(--slate);
    font-weight:700; opacity:0; transform:translateX(-6px);
    transition:all .25s; white-space:nowrap;
  }
  .side-nav a:hover em, .side-nav a.active em{opacity:1;transform:none;}
  .side-nav a.active .house-icon{
    stroke:var(--paper); fill:var(--rust); background:var(--rust);
    box-shadow:0 0 0 4px rgba(196,80,42,.15);
  }

  .to-top{
    position:fixed; right:24px; bottom:24px; width:44px;height:44px;
    border-radius:50%; border:1px solid var(--grid);
    background:var(--paper); color:var(--ink); font-size:18px;
    cursor:pointer; opacity:0; pointer-events:none;
    transition:opacity .3s,transform .3s; z-index:90;
    box-shadow:0 4px 16px rgba(0,0,0,.06);
  }
  .to-top.show{opacity:1;pointer-events:auto;}
  .to-top:hover{transform:translateY(-3px);}

  .reveal{
    opacity:0; transform:translateY(24px);
    transition:opacity .8s ease,transform .8s cubic-bezier(.2,.7,.2,1);
    will-change:opacity,transform;
  }
  .reveal.in{opacity:1;transform:none;}
  figure.wide.reveal{transform:translateX(-50%) translateY(24px);}
  figure.wide.reveal.in{transform:translateX(-50%) translateY(0);}
  .tool-block.reveal{transform:translateX(-50%) translateY(24px);}
  .tool-block.reveal.in{transform:translateX(-50%) translateY(0);}

  @media (max-width:1100px){
    .side-nav{display:none;}
  }
  @media (max-width:768px){
    .page{padding:0 18px 72px;}
    h1{font-size:28px;line-height:1.35;}
    .subtitle{font-size:18px;line-height:1.5;}
    .lede{font-size:18px;line-height:1.7;}
    .kicker{margin-top:40px;}
    .body-text p{font-size:17px;line-height:1.9;}
    h2{font-size:21px;line-height:1.5;margin:44px 0 20px;}
    .byline{grid-template-columns:1fr;gap:6px;}
    .byline .k{flex:0 0 68px;}
    figure.wide{width:calc(100vw - 20px);margin:36px 0;}
    .tool-block{width:calc(100vw - 20px);padding:22px 16px;}
    .tool-block h3{font-size:19px;}
    .notes h2{font-size:19px;}
    .stats{grid-template-columns:repeat(2,1fr);gap:20px 12px;}
    .stat:nth-child(2n){border-right:0;}
    .stat .num{font-size:26px;}
    .bg-scene{height: 40vh;}
  }
</style>
</head>
